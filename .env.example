# Railway / Supabase production configuration
DATABASE_URL=postgresql+psycopg://postgres:password@db.example.supabase.co:5432/postgres
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=https://your-frontend.example
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://nodeflow.up.railway.app/api/v1/auth/github/callback
# Railway provides PORT; local default is 8000.
PORT=8000
